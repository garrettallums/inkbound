{
  "name": "inkbound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Inkbound — a browser-based fantasy map maker",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
